{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Vision Vault Production Metadata Schema",
  "description": "Comprehensive metadata schema for film production documents following industry standards (SMPTE, PBCore, IMF, EIDR)",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "production",
    "document_id",
    "department",
    "creator",
    "position",
    "creation_date",
    "last_modified",
    "version",
    "status",
    "certainty_level",
    "production_phase",
    "document_type"
  ],
  "properties": {
    "production": {
      "type": "string",
      "description": "Full title of the production",
      "minLength": 1,
      "maxLength": 200,
      "examples": ["Desert Bloom", "Shadows of Tomorrow"]
    },
    "document_id": {
      "type": "string",
      "description": "Unique identifier for the document",
      "pattern": "^[A-Z]{2,4}-[A-Z]{2,6}-[A-Za-z0-9]{1,15}-[0-9]{2}-[0-9]{10,13}$",
      "examples": ["CIN-LGTPLN-NightScene-01-1645729844"]
    },
    "department": {
      "type": "string",
      "description": "Department responsible for the document",
      "enum": [
        "Directing",
        "Assistant Directing",
        "Producing",
        "Unit Production Management",
        "Writing",
        "Cinematography",
        "Camera",
        "Lighting",
        "Grip",
        "Production Design",
        "Art Department",
        "Set Decoration",
        "Construction",
        "Props",
        "Costume",
        "Hair & Makeup",
        "Sound",
        "Special Effects",
        "Visual Effects",
        "Stunts",
        "Locations",
        "Transportation",
        "Catering",
        "Safety",
        "Animal Wrangling",
        "Casting",
        "Editing",
        "Post Sound",
        "Music",
        "Color/DI",
        "Marketing",
        "Legal"
      ]
    },
    "creator": {
      "type": "string",
      "description": "Full name of the document creator",
      "minLength": 2,
      "maxLength": 100,
      "examples": ["Jane Smith", "John Doe"]
    },
    "position": {
      "type": "string",
      "description": "Job title/role of the creator",
      "minLength": 2,
      "maxLength": 100,
      "examples": ["Director of Photography", "Production Designer", "1st Assistant Director"]
    },
    "creation_date": {
      "type": "string",
      "format": "date",
      "description": "Date the document was created (YYYY-MM-DD)",
      "examples": ["2025-03-01"]
    },
    "last_modified": {
      "type": "string",
      "format": "date",
      "description": "Date the document was last modified (YYYY-MM-DD)",
      "examples": ["2025-03-15"]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]{1,3}$",
      "description": "Version number of the document",
      "examples": ["01", "02", "15"]
    },
    "status": {
      "type": "string",
      "description": "Current approval/workflow status",
      "enum": [
        "Draft",
        "Work In Progress",
        "In Review",
        "Approved",
        "Final",
        "Revised",
        "Superseded",
        "On Hold",
        "Rejected",
        "Archived"
      ]
    },
    "certainty_level": {
      "type": "integer",
      "description": "Confidence level in the information (1-10 scale)",
      "minimum": 1,
      "maximum": 10,
      "examples": [7, 9]
    },
    "production_phase": {
      "type": "string",
      "description": "Current phase of production",
      "enum": [
        "Development",
        "Pre-Production",
        "Production",
        "Wrap",
        "Post-Production",
        "Delivery",
        "Marketing & Distribution",
        "Archival"
      ]
    },
    "document_type": {
      "type": "string",
      "description": "Classification of the document",
      "enum": [
        "Script",
        "Treatment",
        "Character Bible",
        "Concept Art",
        "Storyboard",
        "Lookbook",
        "Mood Board",
        "Shot List",
        "Music References",
        "Camera Report",
        "Lighting Diagram",
        "Equipment List",
        "Tech Scout Report",
        "Lens Tests",
        "Color Pipeline",
        "Workflow Chart",
        "Signal Flow",
        "Power Distribution",
        "Call Sheet",
        "Production Schedule",
        "Day Out of Days",
        "Location Map",
        "Crew List",
        "Vendor List",
        "Travel Itinerary",
        "Run of Show",
        "Production Report",
        "Budget",
        "Cost Report",
        "Purchase Order",
        "Cash Flow",
        "Petty Cash Log",
        "Invoice Tracker",
        "Labor Report",
        "Contract",
        "Release Form",
        "Insurance Certificate",
        "Permit",
        "Clearance Report",
        "NDA",
        "Deal Memo",
        "Script Breakdown",
        "Prop List",
        "Wardrobe Breakdown",
        "Scene Breakdown",
        "Risk Assessment",
        "Construction Schedule",
        "Prep Schedule",
        "Meeting Notes",
        "Department Brief",
        "Creative Brief",
        "Daily Brief",
        "Change Order",
        "Director's Notes",
        "Screening Notes",
        "Editorial Notes",
        "Test Screening Data",
        "Revision Notes"
      ]
    },
    "related_scenes": {
      "type": "string",
      "description": "Comma-separated list of related scene numbers",
      "examples": ["15, 16, 17", "Act 2 - All", "3A, 3B, 3C"]
    },
    "related_documents": {
      "type": "string",
      "description": "Comma-separated list of related document IDs",
      "examples": ["CIN-SHTLST-Scene15-01, PD-CNCPT-Scene15-01"]
    },
    "dependencies": {
      "type": "string",
      "description": "Comma-separated list of departments affected by this document",
      "examples": ["Lighting, Grip, Production Design", "All Departments"]
    },
    "confidentiality": {
      "type": "string",
      "description": "Access control level for the document",
      "enum": [
        "Public",
        "Internal",
        "Department Only",
        "Heads of Department",
        "Key Creative",
        "Executive",
        "Confidential",
        "Restricted",
        "NDA Required"
      ]
    },
    "notes": {
      "type": "string",
      "description": "Additional contextual notes about the document",
      "maxLength": 1000,
      "examples": ["Initial lighting concept for night scenes", "Pending director approval"]
    },
    "file_path": {
      "type": "string",
      "description": "Location of the document in storage system",
      "examples": ["/production/cinematography/lighting/scene15-night.pdf"]
    },
    "file_size": {
      "type": "integer",
      "description": "File size in bytes",
      "minimum": 0
    },
    "file_format": {
      "type": "string",
      "description": "File format/extension",
      "examples": ["pdf", "docx", "xlsx", "jpg", "mov"]
    },
    "checksum": {
      "type": "string",
      "description": "File integrity checksum (SHA-256)",
      "pattern": "^[a-f0-9]{64}$"
    },
    "tags": {
      "type": "array",
      "description": "Custom tags for additional classification",
      "items": {
        "type": "string"
      },
      "examples": [["night", "exterior", "practical-lights"], ["budget-sensitive", "urgent"]]
    },
    "linked_assets": {
      "type": "array",
      "description": "Related production assets (locations, props, etc.)",
      "items": {
        "type": "object",
        "properties": {
          "asset_type": {
            "type": "string",
            "enum": ["location", "prop", "costume", "vehicle", "equipment", "cast-member", "set"]
          },
          "asset_id": {
            "type": "string"
          },
          "asset_name": {
            "type": "string"
          }
        }
      }
    },
    "approval_chain": {
      "type": "array",
      "description": "Approval workflow history",
      "items": {
        "type": "object",
        "properties": {
          "approver": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "approved", "rejected", "changes-requested"]
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "comments": {
            "type": "string"
          }
        }
      }
    },
    "change_history": {
      "type": "array",
      "description": "Document revision history",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "author": {
            "type": "string"
          },
          "changes": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "technical_metadata": {
      "type": "object",
      "description": "Format-specific technical metadata",
      "properties": {
        "video": {
          "type": "object",
          "properties": {
            "codec": {"type": "string"},
            "resolution": {"type": "string"},
            "frame_rate": {"type": "number"},
            "aspect_ratio": {"type": "string"},
            "color_space": {"type": "string"},
            "bit_depth": {"type": "integer"},
            "duration": {"type": "number"}
          }
        },
        "audio": {
          "type": "object",
          "properties": {
            "codec": {"type": "string"},
            "sample_rate": {"type": "integer"},
            "bit_depth": {"type": "integer"},
            "channels": {"type": "integer"},
            "duration": {"type": "number"}
          }
        },
        "image": {
          "type": "object",
          "properties": {
            "width": {"type": "integer"},
            "height": {"type": "integer"},
            "dpi": {"type": "integer"},
            "color_space": {"type": "string"},
            "bit_depth": {"type": "integer"}
          }
        }
      }
    },
    "ai_analysis": {
      "type": "object",
      "description": "AI-generated metadata and analysis",
      "properties": {
        "summary": {
          "type": "string",
          "description": "AI-generated summary of document content"
        },
        "key_entities": {
          "type": "array",
          "description": "Extracted entities (people, places, things)",
          "items": {"type": "string"}
        },
        "sentiment": {
          "type": "string",
          "enum": ["positive", "neutral", "negative", "mixed"]
        },
        "detected_conflicts": {
          "type": "array",
          "description": "Potential conflicts with other documents",
          "items": {
            "type": "object",
            "properties": {
              "conflict_id": {"type": "string"},
              "type": {"type": "string"},
              "severity": {"type": "string"},
              "description": {"type": "string"},
              "conflicting_document_id": {"type": "string"}
            }
          }
        },
        "suggested_tags": {
          "type": "array",
          "items": {"type": "string"}
        },
        "completeness_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "AI assessment of document completeness"
        },
        "quality_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "AI assessment of document quality"
        }
      }
    },
    "eidr_id": {
      "type": "string",
      "description": "Entertainment Identifier Registry ID (if applicable)",
      "examples": ["10.5240/XXXX-XXXX-XXXX-XXXX-XXXX-X"]
    },
    "imf_compatible": {
      "type": "boolean",
      "description": "Whether document follows IMF (Interoperable Master Format) standards",
      "default": false
    },
    "metadata_version": {
      "type": "string",
      "description": "Version of this metadata schema",
      "default": "1.0.0"
    },
    "created_by_system": {
      "type": "string",
      "description": "System that created this metadata",
      "default": "Vision Vault",
      "examples": ["Vision Vault", "Google Sheets Metadata Generator"]
    }
  },
  "additionalProperties": true,
  "definitions": {
    "department_codes": {
      "DIR": "Directing",
      "AD": "Assistant Directing",
      "PRD": "Producing",
      "UPM": "Unit Production Management",
      "WRI": "Writing",
      "CIN": "Cinematography",
      "CAM": "Camera",
      "LGT": "Lighting",
      "GRP": "Grip",
      "PD": "Production Design",
      "ART": "Art Department",
      "SET": "Set Decoration",
      "CNS": "Construction",
      "PRP": "Props",
      "COS": "Costume",
      "HMU": "Hair & Makeup",
      "SND": "Sound",
      "SFX": "Special Effects",
      "VFX": "Visual Effects",
      "STN": "Stunts",
      "LOC": "Locations",
      "TRN": "Transportation",
      "CAT": "Catering",
      "SAF": "Safety",
      "ANM": "Animal Wrangling",
      "CST": "Casting",
      "EDT": "Editing",
      "PST": "Post Sound",
      "MUS": "Music",
      "CLR": "Color/DI",
      "MKT": "Marketing",
      "LGL": "Legal"
    },
    "status_codes": {
      "DFT": "Draft",
      "WIPP": "Work In Progress",
      "REV": "In Review",
      "APP": "Approved",
      "FIN": "Final",
      "RVS": "Revised",
      "SUP": "Superseded",
      "HLD": "On Hold",
      "REJ": "Rejected",
      "ARC": "Archived"
    }
  }
}
